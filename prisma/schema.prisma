// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TECHNICIAN
}

enum RequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  DONE
  COMPLETED
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String?  @unique
  employeeId String?  @unique
  password   String?
  role       Role     @default(TECHNICIAN)
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assignedRequests RepairRequest[]

  @@map("users")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests RepairRequest[]

  @@map("branches")
}

model RepairRequest {
  id            String        @id @default(uuid())
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  location      String
  description   String
  images        RepairImage[]
  reporterName  String
  reporterPhone String?
  status        RequestStatus @default(PENDING)
  assignedToId  String?
  assignedTo    User?         @relation(fields: [assignedToId], references: [id])
  assignedAt    DateTime?
  slaDeadline   DateTime?
  slaNote       String?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  slaLogs       SlaLog[]

  @@map("repair_requests")
}

model RepairImage {
  id        String        @id @default(uuid())
  requestId String
  request   RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime      @default(now())

  @@map("repair_images")
}

model SlaLog {
  id        String        @id @default(uuid())
  requestId String
  request   RepairRequest @relation(fields: [requestId], references: [id])
  deadline  DateTime
  note      String?
  createdAt DateTime      @default(now())

  @@map("sla_logs")
}
